DIALOGFLOW_PROJECT_ID=catenaccio-sqkl
DIALOGFLOW_LANGUAGE_CODE=es
DIALOGFLOW_AUTH_MODE=adc
# adc ignora GOOGLE_CLIENT_EMAIL y GOOGLE_PRIVATE_KEY; auto utiliza ambas si existen.
# Opcional: utiliza la cuenta de servicio existente o, sin estas dos variables, ADC.
GOOGLE_CLIENT_EMAIL=
# Pega la clave entre comillas y conserva los saltos como \n.
GOOGLE_PRIVATE_KEY=
# Desarrollo: gcloud auth application-default login
# Producción: identidad de servicio con rol Dialogflow API Client.
