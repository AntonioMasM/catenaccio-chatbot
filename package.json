{
  "name": "catenaccio-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook local para Dialogflow expuesto mediante ngrok",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "tunnel": "node src/tunnel.js",
    "test": "node --test"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": {
    "@ngrok/ngrok": "1.7.0",
    "dotenv": "18.0.3",
    "express": "5.2.1"
  }
}
